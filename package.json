{
  "name": "chromatic-watcher",
  "version": "0.1.0",
  "description": "Render Cron Job for monitoring Chromatic job postings via Ashby's public API.",
  "type": "commonjs",
  "main": "check-chromatic-jobs.js",
  "scripts": {
    "start": "node check-chromatic-jobs.js",
    "api": "node server/api.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cron-parser": "^4.9.0",
    "dotenv": "^16.3.1",
    "nodemailer": "^6.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "chromatic": "^18.2.0",
    "storybook": "^10.5.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.1"
  }
}
